# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/safu_infofi?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Blockchain
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
CHAIN_ID=1
REGISTRY_CONTRACT_ADDRESS=0x...
WALLET_LINKER_CONTRACT_ADDRESS=0x...
FEE_COLLECTOR_CONTRACT_ADDRESS=0x...

# Backend Wallet (for signing verification messages)
VERIFIER_PRIVATE_KEY=0x...

# X/Twitter API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# SAFU Domain Verification
SAFU_DOMAIN_RESOLVER_URL=https://api.safu.domains/resolve

# Job Queue
ENABLE_JOBS=true
POST_SYNC_INTERVAL_MINUTES=15
LEADERBOARD_UPDATE_INTERVAL_MINUTES=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# AI/NLP Service (for post relevance scoring)
OPENAI_API_KEY=your_openai_api_key
# or use local alternative
NLP_SERVICE_URL=http://localhost:5000
